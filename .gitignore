# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.pyo
*$py.class

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE and editor files
.vscode/
.idea/
*.sw[op]                # swp и swo
*.orig                  # резервные копии при merge
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs and databases
logs/
*.log
*.log.*                 # ротированные логи
*.sqlite
*.sqlite3
*.db

# Caches
.cache/

# Environment variables and secrets
.env
.env.local
.env.*.local
*.env

# Project specific data volumes (all persistent and temporary data)
data/                   # основная папка данных (включает stats.txt, JSON-файлы)
bocchi_data/            # альтернативное название (если используется)
downloads/              # загруженные файлы
temp/
*.pid

# Docker volumes (if mounted locally)
docker/volumes/

# Test and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Temporary files (excluding already listed patterns)
*.tmp
*.bak
*.lock

# Scripts with local changes (optional)
*_local.sh
*_personal.py

# Output media files (avoid committing downloads)
*.mp3
*.m4a
*.ogg
*.zip
*.rar

# Statistics and state files (already inside data/, listed for clarity)
stats.txt
download_queue_state.json
user_tokens.json
active_status_msgs.json
pending_tasks.json