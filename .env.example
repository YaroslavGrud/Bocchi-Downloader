# ============================================
# Bocchi Downloader – Файл окружения
# ============================================

# ----- Обязательный параметр -----
# Токен Telegram бота (получить у @BotFather)
TELEGRAM_TOKEN=ВАШ_ТОКЕН

# ----- Режим работы бота -----
# stable – стабильная версия (bocchi_bot_host.py)
# beta   – бета-версия (bocchi_host_full.py)
# Если не указан, бот сам выберет существующий файл (сначала ищет полную версию)
BOT_MODE=beta

# ----- Пути и файлы -----
# Путь к исполняемому файлу yandex-music-downloader (внутри контейнера он уже в PATH)
DOWNLOADER_PATH=yandex-music-downloader

# Файл для хранения статистики переданных байт (рекомендуется размещать в volume /app/data)
STATS_FILE=/app/data/stats.txt

# ----- Лимиты и таймауты -----
# Максимальное количество ссылок за раз (1–20)
MAX_LINKS=10

# Таймаут скачивания одного трека (секунды)
DOWNLOAD_TIMEOUT=600

# Таймаут загрузки на облачные сервисы Litterbox/Catbox (секунды)
CLOUD_TIMEOUT=120

# ----- Авторизация Яндекс.Музыки -----
# Время жизни токена пользователя (секунды). 86400 = 24 часа
TOKEN_LIFETIME=86400

# ----- Качество и производительность -----
# Качество по умолчанию: 0 – низкое, 1 – среднее, 2 – высокое
DEFAULT_QUALITY=2

# Минимальное свободное место на диске (МБ). При недостатке качество понижается
MIN_FREE_DISK_MB=20

# Пауза между треками (секунды) для снижения нагрузки
TRACK_DELAY_SECONDS=5.0

# Таймаут ожидания ответа от загрузчика (секунды) – по истечении появляется кнопка "Бот не отвечает?"
STUCK_TIMEOUT=120

# ----- Внутренние файлы состояния (изменять не рекомендуется) -----
# Файлы очереди, токенов и сообщений будут созданы в рабочей директории бота
QUEUE_STATE_FILE=download_queue_state.json
USER_TOKENS_FILE=user_tokens.json
ACTIVE_MSGS_FILE=active_status_msgs.json
PENDING_TASKS_FILE=pending_tasks.json

# ----- Скрытые настройки (обычно не требуют изменений) -----
# Задержка накопления ссылок при отправке нескольких сообщений подряд (секунды)
ACCUMULATION_DELAY=5.0