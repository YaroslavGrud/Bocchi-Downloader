# Обязательный параметр: токен Telegram бота (получить у @BotFather)
TELEGRAM_TOKEN=ваш_токен_здесь

# Путь к исполняемому файлу yandex-music-downloader (по умолчанию ищется в PATH)
DOWNLOADER_PATH=yandex-music-downloader

# Файл для хранения статистики (байт отправлено)
STATS_FILE=stats.txt

# Максимальное количество ссылок за один раз
MAX_LINKS=10

# Таймаут скачивания трека (секунды)
DOWNLOAD_TIMEOUT=600

# Время жизни токена Яндекс.Музыки (секунды, по умолчанию 24 часа)
TOKEN_LIFETIME=86400

# Таймаут загрузки на облачные сервисы (секунды)
CLOUD_TIMEOUT=120

# Качество по умолчанию: 0 – низкое, 1 – среднее, 2 – высокое
DEFAULT_QUALITY=2

# Минимальное свободное место на диске (МБ)
MIN_FREE_DISK_MB=20

# Пауза между треками (секунды) для снижения нагрузки на память
TRACK_DELAY_SECONDS=5.0

# Таймаут ожидания ответа от загрузчика (секунды) перед появлением кнопки "Бот не отвечает?"
STUCK_TIMEOUT=120

QUEUE_STATE_FILE=download_queue_state.json
USER_TOKENS_FILE=user_tokens.json
ACTIVE_MSGS_FILE=active_status_msgs.json
PENDING_TASKS_FILE=pending_tasks.json
